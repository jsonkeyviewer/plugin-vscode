{
  "name": "config-key-viewer",
  "displayName": "JSON YAML XML Key Viewer",
  "description": "Displays the full dot-notation path of any configuration key in JSON, YAML and XML files.",
  "version": "1.0.0",
  "publisher": "DocumentationFirst",
  "author": "Documentation First <contact@documentationfirst.ai>",
  "license": "MIT",
  "homepage": "https://github.com/jsonkeyviewer/plugin-vscode#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/jsonkeyviewer/plugin-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/jsonkeyviewer/plugin-vscode/issues",
    "email": "contact@documentationfirst.ai"
  },
  "icon": "resources/icons/icon.png",
  "pricing": "Free",
  "galleryBanner": {
    "color": "#1E3A5F",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "keywords": ["json", "yaml", "xml", "configuration", "dot notation", "key path"],
  "activationEvents": [
    "onLanguage:json",
    "onLanguage:jsonc",
    "onLanguage:yaml",
    "onLanguage:xml"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "configKeyViewer.formatDocument",
        "title": "Config Key Viewer: Format Document"
      }
    ],
    "configuration": {
      "title": "Config Key Viewer",
      "properties": {
        "configKeyViewer.enabledLanguages": {
          "type": "array",
          "default": ["json", "jsonc", "yaml", "xml"],
          "items": {
            "type": "string",
            "enum": ["json", "jsonc", "yaml", "xml"]
          },
          "uniqueItems": true,
          "description": "Language IDs where Config Key Viewer is enabled."
        },
        "configKeyViewer.tooltipEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Show the full dot-notation key path in a hover tooltip."
        },
        "configKeyViewer.showValueType": {
          "type": "boolean",
          "default": true,
          "description": "Append the value type (string, object, array…) to the tooltip path."
        },
        "configKeyViewer.gutterEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Show a key icon in the gutter with the full key path in its tooltip."
        },
        "configKeyViewer.inlinePathEnabled": {
          "type": "boolean",
          "default": false,
          "description": "Show the full key path as an inline annotation at the end of each key line."
        },
        "configKeyViewer.beautifyHintEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Show a clickable format action when a line holds too many keys (e.g. minified JSON)."
        },
        "configKeyViewer.maxKeysPerLine": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "maximum": 100,
          "description": "Maximum number of keys per line before the beautify hint is shown."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "webpack --config webpack.config.prod.js",
    "compile": "webpack --config webpack.config.dev.js",
    "watch": "webpack --config webpack.config.dev.js --watch",
    "package": "vsce package"
  },
  "devDependencies": {
    "@vscode/vsce": "^4.0.0",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.4.0",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4",
    "webpack-merge": "^5.10.0"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1",
    "yaml": "^2.4.5"
  }
}
